# Copy to .env and adjust. All variables are optional.
# List values are JSON.

EXAMPLE_API_HOST=127.0.0.1
EXAMPLE_API_PORT=8000
EXAMPLE_API_LOG_LEVEL=info
# EXAMPLE_API_CORS_ORIGINS=["https://app.example.com"]

# Hardening
# EXAMPLE_API_DOCS_ENABLED=false        # hide /docs, /redoc and /openapi.json
# EXAMPLE_API_RATE_LIMIT_PER_MINUTE=120 # per client address; 0 turns it off
# EXAMPLE_API_MAX_BODY_BYTES=1048576
# EXAMPLE_API_WORKERS=1
# EXAMPLE_API_SHUTDOWN_TIMEOUT=10

# Running behind a reverse proxy or load balancer (see docs/deployment.md)
# EXAMPLE_API_ALLOWED_HOSTS=["api.example.com", "127.0.0.1"]
# EXAMPLE_API_ROOT_PATH=/myapi
# EXAMPLE_API_FORWARDED_ALLOW_IPS=10.0.0.0/8

# Authentication: none, api_key or jwt
EXAMPLE_API_AUTH_MODE=none
# EXAMPLE_API_API_KEYS=["change-me"]
# EXAMPLE_API_JWT_KEY=change-me
# EXAMPLE_API_JWT_ALGORITHM=HS256
# EXAMPLE_API_JWT_AUDIENCE=
# EXAMPLE_API_JWT_ISSUER=
