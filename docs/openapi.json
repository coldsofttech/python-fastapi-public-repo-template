{
  "components": {
    "schemas": {
      "HealthResponse": {
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "HealthResponse",
        "type": "object"
      },
      "HelloResponse": {
        "properties": {
          "message": {
            "examples": [
              "Hello, Ada!"
            ],
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "title": "HelloResponse",
        "type": "object"
      },
      "ReadyResponse": {
        "properties": {
          "status": {
            "const": "ready",
            "default": "ready",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "description": "Version of the running service.",
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version"
        ],
        "title": "ReadyResponse",
        "type": "object"
      },
      "WhoAmIResponse": {
        "properties": {
          "method": {
            "description": "How the caller was authenticated.",
            "title": "Method",
            "type": "string"
          },
          "subject": {
            "description": "Identity of the caller.",
            "title": "Subject",
            "type": "string"
          }
        },
        "required": [
          "subject",
          "method"
        ],
        "title": "WhoAmIResponse",
        "type": "object"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "in": "header",
        "name": "X-API-Key",
        "type": "apiKey"
      },
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Example HTTP API built on **example_package**.",
    "title": "example-api",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/hello/{name}": {
      "get": {
        "description": "Return a greeting. Public: no authentication required.",
        "operationId": "hello_api_v1_hello__name__get",
        "parameters": [
          {
            "description": "Who to greet.",
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "description": "Who to greet.",
              "title": "Name",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HelloResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "description": "Invalid name."
          }
        },
        "summary": "Greet someone",
        "tags": [
          "v1"
        ]
      }
    },
    "/api/v1/whoami": {
      "get": {
        "description": "Return the authenticated caller. Protected according to ``EXAMPLE_API_AUTH_MODE``.",
        "operationId": "whoami_api_v1_whoami_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WhoAmIResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Authentication failed."
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          },
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Show the caller",
        "tags": [
          "v1"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Return 200 while the process is running.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness probe",
        "tags": [
          "health"
        ]
      }
    },
    "/ready": {
      "get": {
        "description": "Return 200 when the service can take traffic. Add checks for your dependencies here.",
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Readiness probe",
        "tags": [
          "health"
        ]
      }
    }
  }
}
